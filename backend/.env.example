# MongoDB Atlas
# Lấy connection string trong Atlas: Database > Connect > Drivers (Node.js)
# Nhớ thay <username>, <password> và thêm tên database vào cuối path.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/trello_bot?retryWrites=true&w=majority
MONGODB_DB=trello_bot

# Trello
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_SECRET=
TRELLO_BOARD_ID=
DONE_LIST_NAME=Done
REVIEW_LIST_NAME=Review

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DOCS_CHANNEL_ID=

# Server
# URL public mà Trello webhook sẽ gọi vào (vd: https://your-domain.com)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Tuỳ chọn
LOG_RETENTION_DAYS=90
MEETING_DAY=1
MEETING_HOUR=9
DUE_SOON_HOURS=24
CHECK_INTERVAL_MIN=30

